{
  "name": "dibs-easy-for-woocommerce",
  "version": "2.14.1",
  "repository": "git@github.com:krokedil/dibs-easy-one-for-woocommerce.git",
  "author": "Krokedil <info@krokedil.se>",
  "license": "GPL-3.0+",
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@types/react": "^18.3.31",
    "@woocommerce/dependency-extraction-webpack-plugin": "^3.1.0",
    "@wordpress/eslint-plugin": "^12.9.0",
    "@wordpress/html-entities": "^4.55.0",
    "babel-loader": "^10.1.1",
    "eslint": "^8.57.1",
    "glob": "^13.0.6",
    "grunt": "^1.6.3",
    "grunt-contrib-cssmin": "^5.0.0",
    "grunt-wp-i18n": "^1.0.4",
    "prettier": "npm:wp-prettier@^3.0.3",
    "react": "^18.3.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "lintjs": "npx eslint --config ./.eslintrc.json --ext .js assets/js/nets-easy-for-woocommerce.js --fix",
    "lintphp": "composer run lint-fix",
    "clear:transients": "docker-compose run --rm wp-cli wp wc tool run clear_transients --user=1",
    "clear:session": "docker-compose run --rm wp-cli wp wc tool run clear_sessions --user=1",
    "makepot": "npx grunt makepot",
    "cssmin": "npx grunt cssmin",
    "jsmin": "npx webpack",
    "prettier": "npx wp-prettier assets/js --paren-spacing --tab-width 4 --print-width 120 --no-semi --write",
    "webpack:dev": "npx webpack --mode=development --watch",
    "build": "npm run makepot && npm run cssmin && npm run prettier && npm run jsmin"
  }
}
